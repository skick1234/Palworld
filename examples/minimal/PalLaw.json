        "brief": {
          "enabled": true,
          "text": "{action} is not allowed here.",
          "tone": "negative"
        },
        "activity": {
          "enabled": false,
          "text": "{action} is not allowed here."
        }
      }
    },
    "levelDenied": {
      "enabled": true,
      "cooldownSeconds": 3,
      "chat": {
        "enabled": false,
        "text": "Level {minimumLevel} is required to enter {region}."
      },
      "alerts": {
        "brief": {
          "enabled": true,
          "text": "Level {minimumLevel} required - {region}",
          "tone": "negative"
        },
        "activity": {
          "enabled": false,
          "text": "Level {minimumLevel} required - {region}"
        }
      }
    }
