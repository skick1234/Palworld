        "brief": {
          "enabled": false,
          "text": "{region}",
          "tone": "normal"
        },
        "activity": {
          "enabled": true,
          "text": "{region}"
        }
      }
    },
    "actionDenied": {
      "enabled": true,
      "cooldownSeconds": 2,
      "chat": {
        "enabled": false,
        "text": "{action} is not allowed in {region}."
      },
