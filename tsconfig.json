{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": [
    "apps/landing/src", "apps/landing/tests",
    "apps/legal/src", "apps/legal/tests",
    "apps/pallaw/src", "apps/pallaw/tests",
    "apps/shared/src", "apps/shared/tests",
    "vite.config.ts"
  ]
}
