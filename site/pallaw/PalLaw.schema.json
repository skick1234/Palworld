{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PalLaw.schema.json",
  "title": "PalLaw configuration",
  "description": "PalLaw Configuration Version 1. Files are valid UTF-8 JSON, at most 4 MiB including an optional BOM, with no duplicate object keys and a maximum container depth of 32.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "wilderness"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "settings": { "$ref": "#/$defs/settings" },
    "messages": { "$ref": "#/$defs/globalMessages" },
    "wilderness": { "$ref": "#/$defs/wilderness" },
    "regions": {
      "type": "array",
      "maxItems": 1024,
      "description": "At most 1,024 raw ordered named regions. When enabled regions overlap, the last matching entry wins.",
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "mode": {
      "type": "string",
      "enum": ["safe", "pve", "pvp"]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "actor": {
      "type": "string",
      "description": "Actor identifier. The environment target includes natural mineral resource nodes such as stone and ore, but excludes trees and other foliage.",
      "enum": ["player", "partnerPal", "basePal", "wildPal", "npc", "structure", "environment"]
    },
    "sourceActor": {
      "type": "string",
      "enum": ["player", "partnerPal", "basePal", "wildPal", "npc"]
    },
    "sourceSelection": {
      "oneOf": [
        { "$ref": "#/$defs/sourceActor" },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceActor" }
        }
      ]
    },
    "targetSelection": {
      "oneOf": [
        { "$ref": "#/$defs/actor" },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/actor" }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hotReload": { "type": "boolean", "default": true },
        "hotReloadSeconds": { "type": "number", "minimum": 0.1, "maximum": 60, "default": 1 },
        "targetFiltering": { "type": "boolean", "default": true },
        "targetSweepSeconds": { "type": "number", "minimum": 0.05, "maximum": 10, "default": 0.5 },
        "worldRules": { "type": "boolean", "default": true },
        "adminBypass": { "type": "boolean", "default": true },
        "playerSweepSeconds": { "type": "number", "minimum": 0.05, "maximum": 10, "default": 0.25 },
        "mountGraceSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 120,
          "default": 15,
          "description": "Seconds available for safe dismount when an already-mounted player becomes denied; new mount attempts are denied immediately."
        },
        "debugLogging": { "type": "boolean", "default": false }
      }
    },
    "chatChannel": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 512 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "activityAlertChannel": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      ]
    },
    "briefAlertChannel": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 256 },
            "tone": { "type": "string", "enum": ["normal", "negative"], "default": "normal" }
          }
        }
      ]
    },
    "alertChannels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": { "$ref": "#/$defs/briefAlertChannel" },
        "activity": { "$ref": "#/$defs/activityAlertChannel" }
      }
    },
    "messageEvent": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "cooldownSeconds": { "type": "number", "minimum": 0, "maximum": 300 },
            "chat": { "$ref": "#/$defs/chatChannel" },
            "alerts": { "$ref": "#/$defs/alertChannels" }
          }
        }
      ]
    },
    "messageOverrides": {
      "type": "object",
      "description": "Area message overrides. Events omitted here use the current global message defaults.",
      "additionalProperties": false,
      "properties": {
        "regionChanged": { "$ref": "#/$defs/messageEvent" },
        "pvpWarning": { "$ref": "#/$defs/messageEvent" },
        "actionDenied": { "$ref": "#/$defs/messageEvent" },
        "levelDenied": { "$ref": "#/$defs/messageEvent" }
      }
    },
    "globalMessages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "actionNames": { "$ref": "#/$defs/actionNames" },
        "modeNames": { "$ref": "#/$defs/modeNames" },
        "regionChanged": { "$ref": "#/$defs/messageEvent" },
        "pvpWarning": { "$ref": "#/$defs/messageEvent" },
        "actionDenied": { "$ref": "#/$defs/messageEvent" },
        "levelDenied": { "$ref": "#/$defs/messageEvent" }
      }
    },
    "actions": {
      "type": "object",
      "description": "Per-area action overrides. Omitted actions use the selected mode default, which currently allows every action.",
      "additionalProperties": false,
      "properties": {
        "build": { "type": "boolean" },
        "dismantle": { "type": "boolean" },
        "ride": { "type": "boolean" },
        "fly": { "type": "boolean" },
        "editSign": { "type": "boolean" },
        "editLock": { "type": "boolean" },
        "decay": { "type": "boolean" },
        "fastTravelDeparture": { "type": "boolean" },
        "fastTravelArrival": { "type": "boolean" }
      }
    },
    "actionNames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "type": "string", "minLength": 1, "maxLength": 96 },
        "dismantle": { "type": "string", "minLength": 1, "maxLength": 96 },
        "ride": { "type": "string", "minLength": 1, "maxLength": 96 },
        "fly": { "type": "string", "minLength": 1, "maxLength": 96 },
        "editSign": { "type": "string", "minLength": 1, "maxLength": 96 },
        "editLock": { "type": "string", "minLength": 1, "maxLength": 96 },
        "decay": { "type": "string", "minLength": 1, "maxLength": 96 },
        "fastTravelDeparture": { "type": "string", "minLength": 1, "maxLength": 96 },
        "fastTravelArrival": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "modeNames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safe": { "type": "string", "minLength": 1, "maxLength": 96 },
        "pve": { "type": "string", "minLength": 1, "maxLength": 96 },
        "pvp": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "combatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelection" },
        "target": { "$ref": "#/$defs/targetSelection" },
        "allow": { "type": "boolean" },
        "damage": { "type": "number", "minimum": 0, "maximum": 100 },
        "bidirectional": { "type": "boolean", "default": false }
      },
      "oneOf": [
        { "required": ["allow"], "not": { "required": ["damage"] } },
        { "required": ["damage"], "not": { "required": ["allow"] } }
      ]
    },
    "combat": {
      "type": "array",
      "maxItems": 128,
      "description": "At most 128 raw ordered overrides per area, applied after the selected mode. Later matching entries win; relationships without a matching override use the mode default.",
      "items": { "$ref": "#/$defs/combatEntry" }
    },
    "areaMessages": { "$ref": "#/$defs/messageOverrides" },
    "wilderness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "mode": { "$ref": "#/$defs/mode" },
        "actions": { "$ref": "#/$defs/actions" },
        "combat": { "$ref": "#/$defs/combat" },
        "messages": { "$ref": "#/$defs/areaMessages" }
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
      ],
      "items": false
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "polygon"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "enabled": { "type": "boolean", "default": true },
        "mode": { "$ref": "#/$defs/mode" },
        "minimumLevel": { "type": "integer", "minimum": 1, "maximum": 999 },
        "map": { "type": "string", "minLength": 1, "maxLength": 64, "default": "world" },
        "color": { "$ref": "#/$defs/color" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1024,
          "description": "Three to 1,024 raw coordinate pairs. One final point equal to the first is accepted as explicit closure, counts toward the limits, and is removed during normalization. All polygons together may contain at most 65,536 raw points.",
          "items": { "$ref": "#/$defs/point" }
        },
        "actions": { "$ref": "#/$defs/actions" },
        "combat": { "$ref": "#/$defs/combat" },
        "messages": { "$ref": "#/$defs/areaMessages" }
      }
    }
  }
}
