{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PalLaw.v3.schema.json",
  "title": "PalLaw Configuration Version 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modes", "wilderness", "stageAreas"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 3 },
    "regionalCombat": { "$ref": "#/$defs/regionalCombat" },
    "settings": { "$ref": "#/$defs/settings" },
    "messages": { "$ref": "#/$defs/globalMessages" },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "description": "Ordered configuration-owned area modes. Array position is display order.",
      "items": { "$ref": "#/$defs/modeDefinition" }
    },
    "wilderness": { "$ref": "#/$defs/wilderness" },
    "stageAreas": { "$ref": "#/$defs/stageAreas" },
    "regions": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "modeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Immutable mode identifier using lowercase slug syntax."
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "regionalCombat": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean", "default": true } }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hotReload": { "type": "boolean", "default": true },
        "hotReloadSeconds": { "type": "number", "minimum": 0.1, "maximum": 60, "default": 1 },
        "worldRules": { "type": "boolean", "default": true },
        "adminBypass": { "type": "boolean", "default": true },
        "playerSweepSeconds": { "type": "number", "minimum": 0.05, "maximum": 10, "default": 0.25 },
        "mountGraceSeconds": { "type": "number", "minimum": 0, "maximum": 120, "default": 15 },
        "debugLogging": { "type": "boolean", "default": false }
      }
    },
    "chatChannel": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 512 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "activityAlertChannel": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      ]
    },
    "briefAlertChannel": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string", "minLength": 1, "maxLength": 256 },
            "tone": { "enum": ["normal", "negative"] }
          }
        }
      ]
    },
    "alertChannels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": { "$ref": "#/$defs/briefAlertChannel" },
        "activity": { "$ref": "#/$defs/activityAlertChannel" }
      }
    },
    "messageEvent": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "cooldownSeconds": { "type": "number", "minimum": 0, "maximum": 300 },
            "chat": { "$ref": "#/$defs/chatChannel" },
            "alerts": { "$ref": "#/$defs/alertChannels" }
          }
        }
      ]
    },
    "messageOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regionChanged": { "$ref": "#/$defs/messageEvent" },
        "actionDenied": { "$ref": "#/$defs/messageEvent" },
        "levelDenied": { "$ref": "#/$defs/messageEvent" }
      }
    },
    "actionNames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "$ref": "#/$defs/displayName" },
        "dismantle": { "$ref": "#/$defs/displayName" },
        "ride": { "$ref": "#/$defs/displayName" },
        "fly": { "$ref": "#/$defs/displayName" },
        "editSign": { "$ref": "#/$defs/displayName" },
        "editLock": { "$ref": "#/$defs/displayName" },
        "decay": { "$ref": "#/$defs/displayName" },
        "fastTravelDeparture": { "$ref": "#/$defs/displayName" },
        "fastTravelArrival": { "$ref": "#/$defs/displayName" }
      }
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 96 },
    "globalMessages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "actionNames": { "$ref": "#/$defs/actionNames" },
        "regionChanged": { "$ref": "#/$defs/messageEvent" },
        "actionDenied": { "$ref": "#/$defs/messageEvent" },
        "levelDenied": { "$ref": "#/$defs/messageEvent" }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "type": "boolean" },
        "dismantle": { "type": "boolean" },
        "ride": { "type": "boolean" },
        "fly": { "type": "boolean" },
        "editSign": { "type": "boolean" },
        "editLock": { "type": "boolean" },
        "decay": { "type": "boolean" },
        "fastTravelDeparture": { "enum": ["all", "baseOnly", "none"] },
        "fastTravelArrival": { "enum": ["all", "baseOnly", "none"] }
      }
    },
    "modeActions": {
      "allOf": [{ "$ref": "#/$defs/actions" }],
      "required": ["build", "dismantle", "ride", "fly", "editSign", "editLock", "decay", "fastTravelDeparture", "fastTravelArrival"]
    },
    "targetRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player", "partnerPal", "basePal", "baseStructure", "wildPal", "npc", "structure", "environment"],
      "properties": {
        "player": { "type": "boolean" },
        "partnerPal": { "type": "boolean" },
        "basePal": { "type": "boolean" },
        "baseStructure": { "type": "boolean" },
        "wildPal": { "type": "boolean" },
        "npc": { "type": "boolean" },
        "structure": { "type": "boolean" },
        "environment": { "type": "boolean" }
      }
    },
    "modeCombat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player", "partnerPal", "basePal", "baseStructure", "wildPal", "npc"],
      "properties": {
        "player": { "$ref": "#/$defs/targetRow" },
        "partnerPal": { "$ref": "#/$defs/targetRow" },
        "basePal": { "$ref": "#/$defs/targetRow" },
        "baseStructure": { "$ref": "#/$defs/targetRow" },
        "wildPal": { "$ref": "#/$defs/targetRow" },
        "npc": { "$ref": "#/$defs/targetRow" }
      }
    },
    "modeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "minimumLevel", "actions", "combat"],
      "properties": {
        "id": { "$ref": "#/$defs/modeId" },
        "name": { "$ref": "#/$defs/displayName" },
        "color": { "$ref": "#/$defs/color" },
        "minimumLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 999 },
        "actions": { "$ref": "#/$defs/modeActions" },
        "combat": { "$ref": "#/$defs/modeCombat" },
        "messages": { "$ref": "#/$defs/messageOverrides" }
      }
    },
    "actor": { "enum": ["player", "partnerPal", "basePal", "baseStructure", "wildPal", "npc", "structure", "environment"] },
    "sourceActor": { "enum": ["player", "partnerPal", "basePal", "baseStructure", "wildPal", "npc"] },
    "sourceSelection": {
      "oneOf": [
        { "$ref": "#/$defs/sourceActor" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceActor" } }
      ]
    },
    "targetSelection": {
      "oneOf": [
        { "$ref": "#/$defs/actor" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/actor" } }
      ]
    },
    "combatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "allow"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceSelection" },
        "target": { "$ref": "#/$defs/targetSelection" },
        "allow": { "type": "boolean" },
        "bidirectional": { "type": "boolean", "default": false }
      }
    },
    "combatOverrides": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/combatEntry" }
    },
    "areaProperties": {
      "name": { "$ref": "#/$defs/displayName" },
      "mode": { "$ref": "#/$defs/modeId" },
      "actions": { "$ref": "#/$defs/actions" },
      "combat": { "$ref": "#/$defs/combatOverrides" },
      "messages": { "$ref": "#/$defs/messageOverrides" }
    },
    "wilderness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "mode": { "$ref": "#/$defs/modeId" },
        "actions": { "$ref": "#/$defs/actions" },
        "combat": { "$ref": "#/$defs/combatOverrides" },
        "messages": { "$ref": "#/$defs/messageOverrides" }
      }
    },
    "stageAreas": {
      "type": "object",
      "description": "Fixed-priority policy for actors inside Dungeon, Boss Battle, Arena, Room, or Raid Boss stages. Geographic Regions and Wilderness do not apply while this area is active.",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "mode": { "$ref": "#/$defs/modeId" },
        "actions": { "$ref": "#/$defs/actions" },
        "combat": { "$ref": "#/$defs/combatOverrides" },
        "messages": { "$ref": "#/$defs/messageOverrides" }
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
      ],
      "items": false
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "polygon"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "enabled": { "type": "boolean", "default": true },
        "mode": { "$ref": "#/$defs/modeId" },
        "minimumLevel": { "type": "integer", "minimum": 1, "maximum": 999 },
        "map": { "type": "string", "minLength": 1, "maxLength": 64, "default": "world" },
        "polygon": { "type": "array", "minItems": 3, "maxItems": 1024, "items": { "$ref": "#/$defs/point" } },
        "actions": { "$ref": "#/$defs/actions" },
        "combat": { "$ref": "#/$defs/combatOverrides" },
        "messages": { "$ref": "#/$defs/messageOverrides" }
      }
    }
  }
}
