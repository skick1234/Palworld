{
  "$schema": "./PalLaw.schema.json",
  "version": 9,
  "regionalCombat": {
    "enabled": true
  },
  "settings": {
    "hotReload": true,
    "hotReloadSeconds": 1,
    "worldRules": true,
    "adminBypass": true,
    "playerSweepSeconds": 0.25,
    "mountGraceSeconds": 15,
    "debugLogging": false
  },
  "messages": {
    "enabled": true,
    "actionNames": {
      "build": "Xây dựng",
      "flyingMount": "Bay",
      "fastTravelArrival": "Điểm đến dịch chuyển",
      "fastTravelCrossRegionsDeparture": "Fast Travel Cross Regions Departure",
      "fastTravelCrossRegionsArrival": "Fast Travel Cross Regions Arrival"
    },
    "regionChanged": {
      "enabled": true,
      "chat": {
        "enabled": false,
        "text": "Entered {region}."
      },
      "alerts": {
        "activity": {
          "enabled": true,
          "text": "{region}"
        }
      }
    },
    "actionDenied": {
      "enabled": true,
      "cooldownSeconds": 2,
      "chat": {
        "enabled": false,
        "text": "{action} is not allowed in {region}."
      },
      "alerts": {
        "brief": {
          "enabled": true,
          "text": "{action} is not allowed here.",
          "tone": "negative"
        }
      }
    },
    "levelDenied": {
      "enabled": true,
      "cooldownSeconds": 3,
      "chat": {
        "enabled": false,
        "text": "Level {minimumLevel} is required to enter {region}."
      },
      "alerts": {
        "brief": {
          "enabled": true,
          "text": "Level {minimumLevel} required - {region}",
          "tone": "negative"
        }
      }
    }
  },
  "wilderness": {
    "name": "Wilderness",
    "mode": "pve",
    "schedules": ["weekend-pvp"]
  },
  "stageAreas": {
    "name": "Stage Areas",
    "mode": "pve",
    "schedules": []
